    {
      "id": "chiseling_intro",
      "speaker": "ieumi",
      "blocksProcess": true,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "chiseling_intro_1", "text": "이제 결구가 들어갈 부분을 끌로 조금씩 파내자." },
        { "id": "chiseling_intro_2", "text": "한 번에 많이 파기보다 조금씩 깊이를 맞추는 것이 중요해." }
      ]
    },
    {
      "id": "chiseling_result_fail",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "chiseling_result_fail_1", "text": "끌질이 너무 깊거나 먹선을 벗어났군." },
        { "id": "chiseling_result_fail_2", "text": "결구는 조금씩 다듬으며 맞춤을 확인하는 것이 중요하네." },
        { "id": "chiseling_result_fail_3", "text": "한 번 깎아낸 나무는 다시 붙일 수 없는 법이지." },
        { "id": "chiseling_result_fail_4", "text": "다시 한 번 차분히 해보게." }
      ]
    },
    {
      "id": "chiseling_result_pass",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "chiseling_result_pass_1", "text": "나쁘지 않네." },
        { "id": "chiseling_result_pass_2", "text": "조금 거친 부분은 있지만 결구는 충분히 사용할 수 있겠어." },
        { "id": "chiseling_result_pass_3", "text": "다음에는 힘으로 파기보다 조금씩 확인하며 다듬어 보게." },
        { "id": "chiseling_result_pass_4", "text": "장인의 솜씨는 신중함에서 나오는 법일세." }
      ]
    },
    {
      "id": "chiseling_result_excellent",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "chiseling_result_excellent_1", "text": "아주 훌륭하군." },
        { "id": "chiseling_result_excellent_2", "text": "깊이와 모양이 일정하고 결구도 반듯하게 다듬었네." },
        { "id": "chiseling_result_excellent_3", "text": "이 정도면 다른 부재와도 빈틈없이 맞물릴 걸세." }
      ]
    },
    {
      "id": "chapter1_complete",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "chapter1_complete_1", "text": "도리 제작이 끝났군." },
        { "id": "chapter1_complete_2", "text": "아주 훌륭히 수행해주었어." },
        { "id": "chapter1_complete_3", "text": "하지만 우리의 일은 목재 가공에서 그치지 않는다네. 이제 도리를 설치하러 가봄세." }
      ]
    },
    {
      "id": "chapter2_intro",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "chapter2_intro_1", "text": "우리의 일은 좋은 부재를 만드는 것에서 끝나지 않네." },
        { "id": "chapter2_intro_2", "text": "부재는 제자리를 찾아 정확히 맞물려야 비로소 건물의 일부가 되는 법이지." },
        { "id": "chapter2_intro_3", "text": "오늘은 자네 손으로 도리를 제자리에 설치해 보게." }
      ]
    },
    {
      "id": "purlin_align_intro",
      "speaker": "ieumi",
      "blocksProcess": true,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "purlin_align_intro_1", "text": "이제 도리를 설치해 보자!" },
        { "id": "purlin_align_intro_2", "text": "도리는 정해진 방향으로 기둥 위에 올려야 해." },
        { "id": "purlin_align_intro_3", "text": "무리하게 밀어 넣지 말고, 먼저 방향과 각도를 맞춰 보자." }
      ]
    },
    {
      "id": "purlin_align_result_fail",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "purlin_align_result_fail_1", "text": "도리의 방향이 맞지 않았군." },
        { "id": "purlin_align_result_fail_2", "text": "결구는 정해진 방향으로 맞물려야 하는 법이네." },
        { "id": "purlin_align_result_fail_3", "text": "억지로 돌리거나 밀어 넣으면 부재가 손상될 수도 있지." },
        { "id": "purlin_align_result_fail_4", "text": "방향을 다시 맞춰보게." }
      ]
    },
    {
      "id": "purlin_align_result_pass",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "purlin_align_result_pass_1", "text": "좋아." },
        { "id": "purlin_align_result_pass_2", "text": "방향은 거의 맞았네." },
        { "id": "purlin_align_result_pass_3", "text": "조금만 더 세밀하게 각도를 맞춰 보게." }
      ]
    },
    {
      "id": "purlin_align_result_excellent",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "purlin_align_result_excellent_1", "text": "아주 훌륭하군." },
        { "id": "purlin_align_result_excellent_2", "text": "도리의 방향을 정확히 맞췄네." },
        { "id": "purlin_align_result_excellent_3", "text": "이제 자연스럽게 결구를 맞춰보게." }
      ]
    },
    {
      "id": "purlin_joint_intro",
      "speaker": "ieumi",
      "blocksProcess": true,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "purlin_joint_intro_1", "text": "이제 도리를 천천히 내려 결구를 맞물려 보자." },
        { "id": "purlin_joint_intro_2", "text": "힘으로 누르지 말고, 조금씩 위치를 조정하면서 삽입해 봐." }
      ]
    },
    {
      "id": "purlin_joint_result_fail",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "purlin_joint_result_fail_1", "text": "도리의 방향이 맞지 않았군." },
        { "id": "purlin_joint_result_fail_2", "text": "결구는 정해진 방향으로 맞물려야 하는 법이네." },
        { "id": "purlin_joint_result_fail_3", "text": "억지로 돌리거나 밀어 넣으면 부재가 손상될 수도 있지." },
        { "id": "purlin_joint_result_fail_4", "text": "방향을 다시 맞춰보게." }
      ]
    },
    {
      "id": "purlin_joint_result_pass",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "purlin_joint_result_pass_1", "text": "좋군." },
        { "id": "purlin_joint_result_pass_2", "text": "조금 뻑뻑했지만 무리 없이 결구가 맞물렸군." },
        { "id": "purlin_joint_result_pass_3", "text": "다음에는 힘보다 맞춤을 먼저 생각해 보게." }
      ]
    },
    {
      "id": "purlin_joint_result_excellent",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "purlin_joint_result_excellent_1", "text": "완벽해." },
        { "id": "purlin_joint_result_excellent_2", "text": "결구가 빈틈없이 자연스럽게 맞물렸네." },
        { "id": "purlin_joint_result_excellent_3", "text": "이것이 전통 목조건축의 정확한 맞춤일세." }
      ]
    },
    {
      "id": "purlin_complete_ieumi",
      "speaker": "ieumi",
      "blocksProcess": true,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "purlin_complete_ieumi_1", "text": "도리 설치를 무사히 마쳤구나!" },
        { "id": "purlin_complete_ieumi_2", "text": "이제 지붕을 받칠 든든한 뼈대가 완성된 거야." }
      ]
    },
    {
      "id": "chapter2_complete",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "chapter2_complete_1", "text": "수고했네." },
        { "id": "chapter2_complete_2", "text": "자네가 만든 도리가 제자리를 찾았군." },
        { "id": "chapter2_complete_3", "text": "전통 목조건축은 못으로 버티는 것이 아니라 정확한 맞춤으로 서로를 지탱하는 구조라네." },
        { "id": "chapter2_complete_4", "text": "오늘 자네는 그 첫걸음을 직접 완성했네." },
        { "id": "chapter2_complete_5", "text": "더 나아가 이 도리 위에 또 다른 부재를 올려 숭례문을 함께 복원해 보세." }
      ]
    },
    {
      "id": "ending_nojang",
      "speaker": "nojang",
      "blocksProcess": false,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "ending_nojang_1", "text": "자네 손으로 깎은 부재가 저기 올라가 있네." },
        { "id": "ending_nojang_2", "text": "이제 이 일을 아는 사람이 하나 늘었군." }
      ]
    },
    {
      "id": "ending_ieumi",
      "speaker": "ieumi",
      "blocksProcess": false,
      "priority": 10,
      "interruptible": false,
      "lines": [
        { "id": "ending_ieumi_1", "text": "고생 많았어. 다음에 또 물어볼 게 생기면 불러줘." }
      ]
    }
  ]
}
