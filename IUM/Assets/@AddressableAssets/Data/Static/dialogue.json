    {
      "id": "sawing_result_excellent",
      "speaker": "nojang",
      "blocksProcess": true,
      "priority": 20,
      "interruptible": false,
      "lines": [
        { "id": "sawing_result_excellent_1", "text": "아주 좋아." },
        { "id": "sawing_result_excellent_2", "text": "먹선을 정확히 따라 반듯하게 잘 잘랐군." },
        { "id": "sawing_result_excellent_3", "text": "이 정도 솜씨라면 다음 공정으로 넘어가도 되겠네." }
