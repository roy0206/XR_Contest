<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="PauseMenu.uss" />
    <ui:VisualElement name="pause-root" class="pause-root">
        <ui:VisualElement name="pause-menu-panel" class="pause-panel">
            <ui:Label text="일시정지" class="pause-title" />
            <ui:Button name="resume-button" text="계속하기" class="pause-button" />
            <ui:Button name="pause-options-button" text="옵션" class="pause-button" />
            <ui:Button name="restart-process-button" text="공정 다시 시작" class="pause-button" />
            <ui:Button name="main-menu-button" text="메인 화면으로" class="pause-button" />
        </ui:VisualElement>

        <ui:VisualElement name="pause-options-panel" class="pause-panel">
            <ui:Label text="옵션" class="pause-title" />

            <ui:Slider name="music-volume-slider" label="음악 볼륨" low-value="0" high-value="100"
                       show-input-field="true" class="pause-slider" />
            <ui:Slider name="dialogue-volume-slider" label="대사 볼륨" low-value="0" high-value="100"
                       show-input-field="true" class="pause-slider" />
            <ui:Slider name="environment-volume-slider" label="환경 볼륨" low-value="0" high-value="100"
                       show-input-field="true" class="pause-slider" />

            <ui:Button name="close-options-button" text="뒤로" class="pause-button" />
        </ui:VisualElement>

        <ui:VisualElement name="pause-confirm-panel" class="pause-panel">
            <ui:Label name="confirm-message" class="pause-message"
                      text="현재 공정의 작업 내용은 저장되지 않습니다. 메인 화면으로 돌아가시겠습니까?" />
            <ui:VisualElement class="pause-confirm-row">
                <ui:Button name="confirm-no-button" text="취소" class="pause-button pause-button--inline" />
                <ui:Button name="confirm-yes-button" text="메인 화면으로"
                           class="pause-button pause-button--inline pause-button--danger" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
