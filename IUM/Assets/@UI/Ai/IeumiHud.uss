.hud {
    flex-grow: 1;
    justify-content: space-between;
    padding: 24px;
    color: rgb(237, 245, 255);
}

.status {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 10px 18px;
    border-width: 1px;
    border-color: rgba(148, 190, 230, 0.28);
    border-radius: 18px;
    background-color: rgba(14, 24, 43, 0.86);
}

.state-icon {
    margin-right: 10px;
    font-size: 18px;
    color: rgb(120, 140, 165);
}

.state-icon--idle {
    color: rgb(79, 203, 255);
}

.state-icon--listening {
    color: rgb(255, 118, 118);
}

.state-icon--busy {
    color: rgb(255, 205, 96);
}

.state-icon--speaking {
    color: rgb(126, 234, 168);
}

.state-label {
    font-size: 17px;
    -unity-font-style: bold;
}

.level-track {
    width: 120px;
    height: 8px;
    margin-left: 14px;
    border-radius: 4px;
    background-color: rgba(35, 54, 78, 0.9);
    overflow: hidden;
    display: none;
}

.level-track--visible {
    display: flex;
}

.level-fill {
    width: 0;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255, 118, 118);
}

.center {
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
}

.transcript {
    margin-bottom: 10px;
    padding: 6px 16px;
    border-radius: 12px;
    background-color: rgba(7, 12, 24, 0.55);
    font-size: 16px;
    color: rgb(163, 183, 207);
    -unity-text-align: middle-center;
    white-space: normal;
    display: none;
}

.transcript--visible {
    display: flex;
}

.subtitle {
    max-width: 900px;
    padding: 16px 26px;
    border-width: 1px;
    border-color: rgba(148, 190, 230, 0.28);
    border-radius: 20px;
    background-color: rgba(14, 24, 43, 0.94);
    font-size: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
    display: none;
}

.subtitle--visible {
    display: flex;
}

.suggestions {
    margin-top: 16px;
    align-items: center;
    display: none;
}

.suggestions--visible {
    display: flex;
}

.suggestion-button {
    min-width: 420px;
    height: 48px;
    margin-top: 8px;
    padding: 0 20px;
    border-width: 1px;
    border-color: rgba(127, 169, 211, 0.34);
    border-radius: 14px;
    background-color: rgba(31, 48, 73, 0.86);
    color: rgb(231, 241, 252);
    font-size: 17px;
    white-space: normal;
}

.suggestion-button:hover {
    background-color: rgb(42, 67, 98);
    border-color: rgb(83, 196, 255);
}

.debug {
    align-self: flex-end;
    align-items: flex-end;
    padding: 12px 16px;
    border-width: 1px;
    border-color: rgba(148, 190, 230, 0.18);
    border-radius: 14px;
    background-color: rgba(7, 12, 24, 0.72);
}

.debug-label {
    font-size: 13px;
    color: rgb(128, 151, 178);
}

.debug-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.debug-field {
    width: 320px;
    height: 34px;
}

.debug-button {
    height: 34px;
    margin-left: 8px;
    padding: 0 16px;
    border-width: 1px;
    border-color: rgb(77, 206, 255);
    border-radius: 10px;
    background-color: rgb(28, 145, 209);
    color: white;
    font-size: 14px;
}

.debug-hint {
    margin-top: 6px;
    font-size: 12px;
    color: rgb(110, 132, 158);
}
