/* FixedUI.zip의 글래스 메뉴 언어를 기존 StartMenuController 계약에 적용한다. */
.start-screen {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("../../@Developers/RYU/Quest/UI/Fonts/Giants-Bold.ttf");
}

.start-screen-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 8, 13, 0.42);
}

.start-vignette {
    position: absolute;
    width: 760px;
    height: 760px;
    border-radius: 380px;
    background-color: rgba(125, 199, 255, 0.09);
}

.start-vignette--top {
    top: -470px;
    left: -310px;
}

.start-vignette--bottom {
    right: -380px;
    bottom: -520px;
    background-color: rgba(110, 140, 190, 0.08);
}

.start-layout {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 8%;
}

.start-panel,
.start-modal-panel {
    width: 520px;
    padding: 34px 42px 30px 42px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    background-color: rgba(16, 22, 29, 0.94);
}

.start-header {
    flex-shrink: 0;
}

.start-eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(125, 199, 255, 0.92);
}

.start-title {
    margin-top: 3px;
    font-size: 36px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
}

.start-subtitle,
.start-modal-subtitle {
    margin-top: 6px;
    font-size: 15px;
    white-space: normal;
    color: rgba(255, 255, 255, 0.58);
}

.start-divider {
    height: 1px;
    margin-top: 20px;
    margin-bottom: 14px;
    background-color: rgba(255, 255, 255, 0.16);
}

.start-button-group {
    flex-grow: 1;
}

.start-button {
    height: 44px;
    margin-top: 10px;
    padding: 0;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(255, 255, 255, 0.9);
    color: rgba(25, 25, 25, 0.86);
    -unity-text-align: middle-left;
}

.start-button--first {
    margin-top: 0;
}

.start-button:hover,
.start-button:focus {
    background-color: rgb(255, 255, 255);
    color: rgb(25, 25, 25);
}

.start-button:active,
.start-button--accent:active {
    background-color: rgb(125, 199, 255);
}

.start-button:disabled {
    background-color: rgba(255, 255, 255, 0.2);
    color: rgba(25, 25, 25, 0.26);
    opacity: 0.58;
}

.start-button--quiet {
    background-color: rgba(255, 255, 255, 0.76);
}

.start-button-indicator {
    width: 4px;
    min-width: 4px;
    height: 24px;
    margin-left: 8px;
    margin-right: 10px;
    border-radius: 2px;
    background-color: rgba(125, 199, 255, 0);
}

.start-button:hover .start-button-indicator,
.start-button:focus .start-button-indicator,
.start-button:active .start-button-indicator {
    background-color: rgb(125, 199, 255);
}

.start-button-icon {
    width: 23px;
    min-width: 23px;
    height: 23px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.start-icon--play {
    background-image: url("../Pause/FixedUI/Icons/play_arrow_48dp_000000_FILL0_wght400_GRAD0_opsz48.png");
}

.start-icon--continue {
    background-image: url("../Pause/FixedUI/Icons/replay_48dp_000000_FILL0_wght400_GRAD0_opsz48.png");
}

.start-icon--options {
    background-image: url("../Pause/FixedUI/Icons/settings_48dp_000000_FILL0_wght400_GRAD0_opsz48.png");
}

.start-icon--exit {
    background-image: url("../Pause/FixedUI/Icons/home_48dp_000000_FILL0_wght400_GRAD0_opsz48.png");
}

.start-button-label {
    flex-grow: 1;
    font-size: 17px;
    color: rgba(25, 25, 25, 0.86);
}

.start-button-label--center {
    -unity-text-align: middle-center;
}

.start-save-notice {
    display: none;
    margin-top: 14px;
    font-size: 14px;
    color: rgb(255, 190, 130);
    white-space: normal;
    -unity-text-align: middle-center;
}

.save-notice--visible {
    display: flex;
}

.start-input-hint {
    margin-top: 15px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.34);
    -unity-text-align: middle-center;
}

.start-modal-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 7, 12, 0.82);
}

.start-modal-panel--options {
    width: 570px;
    min-height: 510px;
}

.start-modal-panel--confirm {
    width: 520px;
    min-height: 230px;
    justify-content: center;
}

.start-modal-title {
    margin-top: 2px;
    font-size: 30px;
    color: rgb(255, 255, 255);
}

.start-modal-title--center {
    -unity-text-align: middle-center;
}

.start-slider {
    height: 48px;
    margin-top: 8px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.84);
}

.start-slider .unity-base-field__label {
    min-width: 105px;
    color: rgba(255, 255, 255, 0.76);
}

.start-slider .unity-base-slider__tracker {
    height: 5px;
    background-color: rgba(255, 255, 255, 0.2);
}

.start-slider .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(125, 199, 255);
}

.start-button--footer {
    margin-top: 20px;
}

.start-confirm-message {
    margin-top: 18px;
    margin-bottom: 28px;
    font-size: 17px;
    color: rgba(255, 255, 255, 0.72);
    white-space: normal;
    -unity-text-align: middle-center;
}

.start-confirm-row {
    flex-direction: row;
    justify-content: space-between;
}

.start-button--inline {
    flex-grow: 1;
    margin-left: 5px;
    margin-right: 5px;
}

.start-button--accent {
    background-color: rgb(255, 255, 255);
}
